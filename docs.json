{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "WinWinKit",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "colors": {
    "primary": "#111113",
    "light": "#D4FF70",
    "dark": "#111113"
  },
  "background": {
    "color": {
      "light": "#FCFCFD",
      "dark": "#111113"
    }
  },
  "logo": {
    "dark": "/logo.svg",
    "light": "/logo.svg",
    "href": "https://winwinkit.com"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "groups": [
      {
        "group": "Intro",
        "pages": [
          "api-reference/introduction",
          "api-reference/authentication",
          "api-reference/errors"
        ]
      },
      {
        "group": "Client API",
        "pages": [
          {
            "group": "Users",
            "pages": [
              "api-reference/users/create-or-update-user",
              "api-reference/users/get-user"
            ]
          },
          {
            "group": "User Rewards",
            "pages": ["api-reference/rewards-actions/withdraw-credits"]
          },
          {
            "group": "Claim Code",
            "pages": ["api-reference/claim-actions/claim-code"]
          },
          {
            "group": "Transactions",
            "pages": [
              "api-reference/transactions/app-store",
              "api-reference/transactions/google-play"
            ]
          }
        ]
      },
      {
        "group": "Platform API",
        "pages": [
          {
            "group": "User Rewards",
            "pages": ["api-reference/rewards-actions/grant-a-reward"]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "https://api.winwinkit.com/openapi-yaml",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript"]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/winwinkit"
      },
      {
        "label": "Get Started",
        "href": "https://winwinkit.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://winwinkit.com",
      "reddit": "https://reddit.com/r/winwinkit",
      "linkedin": "https://linkedin.com/company/winwinkit",
      "bluesky": "https://bsky.app/profile/winwinkit.bsky.social",
      "x-twitter": "https://x.com/winwin_kit",
      "github": "https://github.com/winwinkit"
    }
  },
  "redirects": [
    {
      "source": "/changelog/product-updates",
      "destination": "https://winwinkit.com/changelog"
    }
  ]
}
